#!/usr/bin/env python3
"""Servidores web do mundo do jogo, todos num processo so.

Cada servico abre o socket dentro do network namespace do seu host (setns),
entao para quem esta no notebook eles sao maquinas diferentes na rede. Cada
requisicao e avisada ao jogo pela serial 1 (EF:HTTP ...).
"""
import html
import importlib.util
import json
import os
import sys
import threading
import urllib.parse
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

CANAL = "/dev/ttyS1"
_trava = threading.Lock()


def avisar(*campos):
    linha = "EF:HTTP " + "\t".join(str(c).replace("\t", " ").replace("\n", " ") for c in campos) + "\n"
    with _trava:
        try:
            with open(CANAL, "w") as f:
                f.write(linha)
        except OSError:
            pass


def carregar_app(caminho):
    spec = importlib.util.spec_from_file_location("app_" + str(abs(hash(caminho))), caminho)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def fabricar_handler(cfg):
    raiz = cfg["raiz"]
    listar = tuple(cfg.get("listar", []))
    negar = tuple(cfg.get("negar", []))
    app = carregar_app(cfg["app"]) if cfg.get("app") else None
    nome_servidor = cfg.get("server", "Apache")
    # bloqueio só do caminho exato (o tipo de "correção" que esquece o resto)
    negar_exato = set(cfg.get("negarExato", []))

    class Handler(SimpleHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def __init__(self, *a, **kw):
            super().__init__(*a, directory=raiz, **kw)

        def version_string(self):
            return nome_servidor

        def log_message(self, *a):
            pass

        def send_response(self, code, message=None):
            self._status = code
            super().send_response(code, message)

        def _caminho(self):
            return urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)

        def _responder(self, status, corpo, tipo="text/html; charset=utf-8", extras=None):
            dados = corpo.encode() if isinstance(corpo, str) else corpo
            self.send_response(status)
            self.send_header("Content-Type", tipo)
            self.send_header("Content-Length", str(len(dados)))
            for k, v in (extras or {}).items():
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(dados)

        def _erro_apache(self, status, titulo, texto):
            corpo = (
                '<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">\n'
                f"<html><head>\n<title>{status} {titulo}</title>\n</head><body>\n"
                f"<h1>{titulo}</h1>\n<p>{texto}</p>\n<hr>\n"
                f"<address>{nome_servidor} Server at {self.headers.get('Host', cfg['ip'])} Port {cfg['porta']}</address>\n"
                "</body></html>\n"
            )
            personalizada = os.path.join(raiz, f"{status}.html")
            if os.path.isfile(personalizada):
                with open(personalizada, encoding="utf-8") as f:
                    corpo = f.read()
            self._responder(status, corpo)

        def send_error(self, code, message=None, explain=None):
            if code == 404:
                self._erro_apache(404, "Not Found", "The requested URL was not found on this server.")
            elif code == 403:
                self._erro_apache(403, "Forbidden", "You don't have permission to access this resource.")
            else:
                super().send_error(code, message, explain)

        def _tratar(self, metodo):
            self._status = 0
            caminho = self._caminho()
            corpo = b""
            if metodo == "POST":
                n = int(self.headers.get("Content-Length") or 0)
                corpo = self.rfile.read(n) if n > 0 else b""
            try:
                if caminho in negar_exato or any(caminho.startswith(p) for p in negar):
                    self.send_error(403)
                    return
                if app is not None:
                    r = app.tratar(metodo, self.path, dict(self.headers), corpo)
                    if r is not None:
                        status, tipo, dados, extras = (list(r) + [None])[:4]
                        self._responder(status, dados, tipo, extras)
                        return
                if metodo == "POST":
                    self.send_error(405)
                    return
                if metodo == "HEAD":
                    super().do_HEAD()
                else:
                    super().do_GET()
            finally:
                avisar(cfg["host"], cfg["porta"], metodo, self.path, self._status,
                       self.headers.get("User-Agent", "-"))

        def do_GET(self):
            self._tratar("GET")

        def do_HEAD(self):
            self._tratar("HEAD")

        def do_POST(self):
            self._tratar("POST")

        def list_directory(self, path):
            url = self._caminho()
            if not any(url.startswith(p) for p in listar):
                self.send_error(403)
                return None
            try:
                nomes = sorted(os.listdir(path))
            except OSError:
                self.send_error(404)
                return None
            t = html.escape(url)
            linhas = [
                '<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">',
                f"<html>\n <head>\n  <title>Index of {t}</title>\n </head>\n <body>",
                f"<h1>Index of {t}</h1>\n<ul>",
                '<li><a href="../"> Parent Directory</a></li>',
            ]
            for n in nomes:
                barra = "/" if os.path.isdir(os.path.join(path, n)) else ""
                linhas.append(f'<li><a href="{urllib.parse.quote(n)}{barra}"> {html.escape(n)}{barra}</a></li>')
            linhas.append(f"</ul>\n<address>{nome_servidor} Server at {cfg['ip']} Port {cfg['porta']}</address>\n</body></html>\n")
            dados = "\n".join(linhas).encode()
            self._responder(200, dados)
            return None

    return Handler


def main():
    with open(sys.argv[1], encoding="utf-8") as f:
        servicos = json.load(f)
    ns_original = os.open("/proc/self/ns/net", os.O_RDONLY)
    servidores = []
    for cfg in servicos:
        fd = os.open(f"/run/netns/{cfg['host']}", os.O_RDONLY)
        os.setns(fd, os.CLONE_NEWNET)
        os.close(fd)
        ThreadingHTTPServer.allow_reuse_address = True
        srv = ThreadingHTTPServer((cfg["ip"], cfg["porta"]), fabricar_handler(cfg))
        srv.daemon_threads = True
        servidores.append(srv)
        os.setns(ns_original, os.CLONE_NEWNET)
    for srv in servidores:
        threading.Thread(target=srv.serve_forever, daemon=True).start()
    open("/run/ef-mundo.pronto", "w").close()
    threading.Event().wait()


if __name__ == "__main__":
    main()
